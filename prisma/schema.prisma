generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id       Int      @id @default(autoincrement())
  nome     String
  email    String   @unique
  senha    String
  tipo     String
  criadoEm DateTime @default(now())
}

model Noticia {
  id       Int      @id @default(autoincrement())
  titulo   String
  resumo   String
  conteudo String?
  imagem   String?
  criadoEm DateTime @default(now())
}

model DocumentoTransparencia {
  id       Int      @id @default(autoincrement())
  titulo   String
  tipo     String
  data     DateTime
  arquivo  String?
  criadoEm DateTime @default(now())
}

model Licitacao {
  id         Int      @id @default(autoincrement())
  titulo     String
  modalidade String
  status     String
  data       DateTime
  arquivo    String?
  criadoEm   DateTime @default(now())
}
